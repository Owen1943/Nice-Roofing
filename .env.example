# Public build-time values. Keep review copies out of search indexes.
NEXT_PUBLIC_SITE_URL=http://localhost:8080
NEXT_PUBLIC_INDEXABLE=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Server-only. Confirm recipient with owner; never guess between conflicting ads.
SITE_ORIGIN=http://localhost:8080
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
RESEND_API_KEY=
ABUSE_HASH_SECRET=
TRUSTED_PROXY=nginx
# Docker uses Redis URL; managed Workers use Upstash REST instead.
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=
